+describe('getDashboardSections, subscription section', () => {
+  beforeEach(() => vi.clearAllMocks());
+
+  it('names the nodes by the cached subscription links, then the fallback links', async () => {
+    PodkopShellMethods.getSubscriptionLinks.mockResolvedValue({
+      success: true,
+      data: [
+        'vless://id@10.0.0.1:443#%F0%9F%87%A9%F0%9F%87%AA%20Germany',
+        'vless://id@10.0.0.2:443#Poland',
+      ],
+    });
+    mockUrlTest(
+      {
+        '.name': 'main',
+        connection_type: 'proxy',
+        proxy_config_type: 'subscription',
+        subscription_url: 'https://example.com/sub',
+        urltest_fallback_links: ['socks5://10.0.0.3:1080#Fallback'],
+      },
+      ['main-1-out', 'main-2-out', 'main-fallback-1-out'],
+    );
+
+    expect(await tileNames()).toEqual([
+      'Fastest',
+      '🇩🇪 Germany',
+      'Poland',
+      'Fallback',
+    ]);
+    expect(PodkopShellMethods.getSubscriptionLinks).toHaveBeenCalledWith(
+      'main',
+    );
+  });
+
+  it('falls back to the outbound names when the cache is unavailable', async () => {
+    PodkopShellMethods.getSubscriptionLinks.mockResolvedValue({
+      success: false,
+      error: '',
+    });
+    mockUrlTest(
+      {
+        '.name': 'main',
+        connection_type: 'proxy',
+        proxy_config_type: 'subscription',
+        subscription_url: 'https://example.com/sub',
+      },
+      ['main-1-out'],
+    );
+
+    expect(await tileNames()).toEqual(['Fastest', 'main-1-out']);
+  });
+});
